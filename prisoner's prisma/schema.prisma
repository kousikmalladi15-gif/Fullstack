datasource db{
    provider="postgresql"
}


generator client{
    provider="prisma-client-js"
}


model User{
    id  String @id
    email String @unique
    role Role @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


enum Role{
    USER
    ADMIN
    SUPER_ADMIN
}

